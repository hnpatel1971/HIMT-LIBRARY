DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/library
SESSION_SECRET=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
PORT=5000
FILES_DIR=../files

# Single sign-on from the Employee Portal (off when SSO_API_KEY is empty).
SSO_API_KEY=
# Optional: comma-separated IPs allowed to ask for tickets, e.g. 127.0.0.1
SSO_ALLOWED_IPS=
# Optional: the library's public address, used in the login links.
PUBLIC_URL=https://library.himt.in
# Optional: sites allowed to show the library in an iframe, e.g. https://portal.himt.in
FRAME_ANCESTORS=
