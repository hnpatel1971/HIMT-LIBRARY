<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS site for the HIMT Library. IIS receives the requests (and handles HTTPS
  once a certificate is bound) and forwards everything to the Node service on
  port 8090, which serves both the API and the web app. Uses the same URL
  Rewrite and ARR set-up as HIMT-LMS; deploy/windows/install.ps1 checks it.
-->
<configuration>
  <system.webServer>
    <!-- E-book PDFs can be up to 100 MB (IIS allows 30 MB by default). -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>
    <rewrite>
      <rules>
        <rule name="HIMT-Library over HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="on" ignoreCase="true" />
          </conditions>
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8090/{R:1}" />
        </rule>
        <rule name="HIMT-Library over HTTP" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="http" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8090/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
